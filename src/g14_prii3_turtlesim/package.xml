<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>g14_prii3_turtlesim</name>
  <version>0.0.0</version>

  <description>
    Control de turtlesim para el proyecto PRII3 del grupo 14
  </description>

  <maintainer email="vicent@todo.todo">
    vicent
  </maintainer>

  <license>TODO</license>

  <!-- Dependencias del nodo -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>turtlesim</exec_depend>

  <!-- Servicio reset -->
  <exec_depend>std_srvs</exec_depend>

  <!-- Nuestro servicio personalizado -->
  <exec_depend>g14_prii3_interfaces</exec_depend>

  <!-- Necesario para el fichero launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
